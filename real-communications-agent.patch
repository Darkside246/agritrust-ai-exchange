+  ];
+
+  let finalText = '';
+
+  try {
+    for (let i = 0; i < MAX_TOOL_ITERATIONS; i++) {
+      // Every tool call an agent attempts still has to clear the same
+      // governance check any other agent action would (Section 19/62).
+      const permission = AIGovernanceEngine.validateAgentActionPermission(
+        'communications-agent',
+        'WHATSAPP_DRAFT_REPLY',
+        false
