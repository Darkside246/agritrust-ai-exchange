# ─── Required ─────────────────────────────────────────────────────────────────

# Anthropic AI - needed for AI agent to generate real replies
ANTHROPIC_API_KEY=sk-ant-...

# AES-256-GCM key for encrypting WhatsApp chat/contact/message data at rest
# Use a long random string - e.g. openssl rand -hex 32
WHATSAPP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# ─── Optional ─────────────────────────────────────────────────────────────────

# Port (Railway sets this automatically)
PORT=5000

# Meta Cloud API (only needed for production WhatsApp Business API)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_WABA_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Set to 1 to run live integration tests that hit real external services
# REAL_META_TEST=1
# REAL_WA_TEST=1
